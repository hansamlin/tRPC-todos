{
  "name": "@todos/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/router.ts"
  },
  "scripts": {
    "dev": "bun --watch --env-file=../.env src/index.ts",
    "start": "bun --env-file=../.env src/index.ts",
    "db:push": "bun --env-file=../.env x drizzle-kit push",
    "db:generate": "bun --env-file=../.env x drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@todos/shared": "workspace:*",
    "@trpc/server": "^11.18.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "7.0.2"
  }
}
