# --- postgres (docker compose) ---
POSTGRES_USER=todos
POSTGRES_PASSWORD=todos_dev_password
POSTGRES_DB=todos
POSTGRES_PORT=5432

# --- server ---
DATABASE_URL=postgres://todos:todos_dev_password@localhost:5432/todos
PORT=3000
CORS_ORIGIN=http://localhost:5173

# JWT secrets — 產生方式: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-change-me-change-me
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-change-me
# 可設定的 TTL（vercel/ms 格式），預設 access 1 小時 / refresh 1 天
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=1d

# --- web ---
VITE_API_URL=http://localhost:3000/trpc
